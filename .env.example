# Live AI chat (server-side only — never prefix with VITE_, it must not reach the browser)
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5). Cheaper/faster options: claude-sonnet-5-5, claude-haiku-5-5
# CHAT_MODEL=claude-sonnet-5-5
# Optional: port for `npm start`
# PORT=8787

# ---- Accounts, orders & notifications ----
# Comma-separated emails that get the admin role (orders + stock panel at /admin) when they register or log in
ADMIN_EMAILS=
# Telegram order notifications (create a bot with @BotFather; chat id of you/your group)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Initial delivery pricing (AZN) — afterwards edit it in /admin → Settings.
# DELIVERY_FEE_AZN=
# FREE_DELIVERY_FROM_AZN=
# Where the SQLite database is stored (default ./data) — back this folder up
# DATA_DIR=./data
# Set to 1 when served over HTTPS behind a proxy that does not send X-Forwarded-Proto
# COOKIE_SECURE=1

# ---- Online card payments (Epoint, https://epoint.az) ----
# Public address of the site, e.g. https://halhala.az — used for the bank's success/failure return links.
PUBLIC_URL=
EPOINT_PUBLIC_KEY=
EPOINT_PRIVATE_KEY=
# In the Epoint merchant cabinet set the "Result URL" to:  <PUBLIC_URL>/api/payments/epoint/callback
# Card payments switch on automatically when all three values above are set.
# EPOINT_BASE_URL=https://epoint.az        # override only for a sandbox
# CARD_HOLD_MINUTES=30                     # unpaid card orders release their stock after this long

# Extra browser origins allowed to call the API (comma-separated). PUBLIC_URL is always allowed.
# ALLOWED_ORIGINS=https://www.halhala.az
